# Backend Rails Environment Variables
# Copy this file to .env and fill with your values

# Rails Master Key (generate with: rails secret)
RAILS_MASTER_KEY=your_rails_master_key_here

# JWT Secret Key (generate with: rails secret)
JWT_SECRET_KEY=your_jwt_secret_key_here

# Database URL for Docker
DATABASE_URL=postgres://eshop:eshop_password@db:5432/eshop_development
