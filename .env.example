# Backend Rails Environment Variables
# Copy this file to .env and fill with your values (do NOT commit .env)

# Rails Master Key (generate: bin/rails secret, then bin/rails credentials:edit)
RAILS_MASTER_KEY=your_rails_master_key_here

# JWT Secret (backend falls back to Rails credentials if unset)
JWT_SECRET_KEY=your_jwt_secret_key_here

# Database URL for Docker
DATABASE_URL=postgres://eshop:eshop_password@db:5432/eshop_development

# Frontend origin allowed by CORS (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:4200