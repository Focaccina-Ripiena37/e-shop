# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore key files for decrypting credentials and more.
/config/*.key

# SQLite databases
*.sqlite3
*.sqlite3-*
/db/*.sqlite3
/db/*.sqlite3-journal

# Ignore vendor bundle (dependencies installed locally)
/vendor/bundle

# Ignore Gemfile.lock for libraries (keep for apps - comment out if needed)
# Gemfile.lock

# Byebug history
.byebug_history

# Spring files
/spring/*.pid

# Test files generated
/spec/examples.txt
/coverage

# System files
.DS_Store
Thumbs.db

# IDE files
.idea/
*.swp
*.swo
*~

# Uploads in development
/public/uploads

# Node modules (if any JS dependencies)
/node_modules

# Manual test files (curl/Postman payloads - not formal tests)
test_*.json
*.http
*.rest


# SQLite test database artifact
eshop_test

